<?xml version="1.0"?>
<package format="3">
  <name>uav_autonomy</name><version>0.1.0</version>
  <description>Unknown-environment tasks, model-independent lidar and GanYu integration.</description>
  <maintainer email="ake@example.com">ake</maintainer><license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>rclpy</depend><depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend><depend>nav_msgs</depend><depend>std_msgs</depend>
  <depend>tf2_ros</depend><depend>tf2_eigen</depend><depend>px4_msgs</depend>
  <depend>uav_common_msg</depend><depend>eigen</depend><depend>octomap</depend>
  <depend>uav_ganyu_control</depend><depend>rosgraph_msgs</depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
