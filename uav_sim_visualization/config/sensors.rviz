Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane: XY
    Reference Frame: odom
    Color: 100; 100; 110
    Alpha: 0.35
    Value: true
  - Class: rviz_default_plugins/Axes
    Name: Vehicle axes
    Enabled: true
    Reference Frame: base_link
    Length: 0.5
    Radius: 0.015
    Value: true
  - Class: rviz_default_plugins/PointCloud2
    Name: MID-360 point cloud
    Enabled: true
    Topic:
      Value: /lidar/points
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Autocompute Value Bounds: true
    Style: Points
    Size (Pixels): 3
    Size (m): 0.025
    Alpha: 1
    Decay Time: 0.15
    Use Fixed Frame: true
    Value: true
  - Class: rviz_default_plugins/Image
    Name: RGB camera
    Enabled: true
    Topic:
      Value: /camera/image
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 2
    Transport Hint: raw
    Queue Size: 2
    Normalize Range: true
    Value: true
  Global Options:
    Fixed Frame: odom
    Background Color: 24; 24; 28
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: base_link
      Distance: 12
      Pitch: 0.65
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1400
  Height: 900
  X: 80
  Y: 60
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Displays:
    collapsed: false
  RGB camera:
    collapsed: false
  Views:
    collapsed: false
