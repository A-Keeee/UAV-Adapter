Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Metre grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 60
    Reference Frame: odom
    Color: 90; 90; 100
  - Class: rviz_default_plugins/MarkerArray
    Name: Walls + safety inflation + waypoints
    Enabled: true
    Topic:
      Value: /planning/markers
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
  - Class: rviz_default_plugins/Path
    Name: A star search - orange
    Enabled: true
    Topic:
      Value: /planning/astar_path
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
    Line Style: Lines
    Color: 255; 150; 40
    Alpha: 0.9
    Line Width: 0.04
    Buffer Length: 1
  - Class: rviz_default_plugins/Path
    Name: B spline plan - cyan
    Enabled: true
    Topic:
      Value: /planning/bspline_path
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
    Line Style: Billboards
    Color: 30; 220; 255
    Alpha: 1
    Line Width: 0.065
    Buffer Length: 1
  - Class: rviz_default_plugins/Path
    Name: Actual flight - green
    Enabled: true
    Topic:
      Value: /planning/actual_path
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 1
    Line Style: Billboards
    Color: 80; 255; 110
    Alpha: 1
    Line Width: 0.045
    Buffer Length: 1
  - Class: rviz_default_plugins/Axes
    Name: Vehicle
    Enabled: true
    Reference Frame: base_link
    Length: 0.6
    Radius: 0.04
  - Class: rviz_default_plugins/PointCloud2
    Name: MID360 cloud (optional)
    Enabled: false
    Topic:
      Value: /lidar/points
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 2
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Style: Points
    Size (Pixels): 2
    Decay Time: 0.15
  Global Options:
    Fixed Frame: odom
    Background Color: 24; 27; 34
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: odom
      Distance: 42
      Pitch: 1.05
      Yaw: 0.8
      Focal Point:
        X: 5
        Y: 3
        Z: 2
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1440
  Height: 950
