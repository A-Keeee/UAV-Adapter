<?xml version="1.0" encoding="UTF-8"?>
<!-- Isolated interface fixtures only; never exported into flight sessions.
     The resource-limit fixture contains a real 48,000,012-byte cloud.
     https://fast-dds.docs.eprosima.com/en/2.6.x/fastdds/transport/shared_memory/shared_memory.html -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>fixture_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>fixture_large_shm</transport_id>
      <type>SHM</type>
      <segment_size>268435456</segment_size>
      <port_queue_capacity>8192</port_queue_capacity>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="isolated_interface" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>fixture_udp</transport_id>
        <transport_id>fixture_large_shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
