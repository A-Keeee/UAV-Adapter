<?xml version="1.0"?>
<sdf version="1.9">
  <model name="x500_mid360">
    <include merge="true">
      <uri>model://x500_depth</uri>
    </include>
    <!-- The original airframe and camera are included unchanged. The added payload is 265 g. -->
    <link name="mid360_link">
      <pose relative_to="base_link">0 0 0.12 0 0 0</pose>
      <inertial>
        <mass>0.265</mass>
        <inertia>
          <ixx>0.0001728020833333333</ixx>
          <iyy>0.0001728020833333333</iyy>
          <izz>0.0001866041666666667</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="mid360_collision">
        <geometry><box><size>0.065 0.065 0.060</size></box></geometry>
      </collision>
      <visual name="mid360_housing">
        <geometry><box><size>0.065 0.065 0.060</size></box></geometry>
        <material><ambient>0.08 0.10 0.12 1</ambient><diffuse>0.12 0.15 0.18 1</diffuse></material>
      </visual>
      <visual name="mid360_lens">
        <pose>0 0 0.018 0 0 0</pose>
        <geometry><cylinder><radius>0.0326</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.12 0.22 0.28 1</ambient><diffuse>0.18 0.36 0.42 1</diffuse></material>
      </visual>
      <sensor name="mid360" type="custom">
        <plugin filename="RGLServerPluginInstance" name="rgl::RGLServerPluginInstance">
          <range><min>0.1</min><max>40</max></range>
          <update_rate>10</update_rate>
          <update_on_paused_sim>false</update_on_paused_sim>
          <topic>/mid360/points</topic>
          <frame>mid360_link</frame>
          <pattern_preset>Livox Mid360</pattern_preset>
        </plugin>
      </sensor>
    </link>
    <joint name="mid360_joint" type="fixed">
      <parent>base_link</parent><child>mid360_link</child>
    </joint>
  </model>
</sdf>
