<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="x500_avia">
    <include merge="true">
      <uri>model://x500_depth</uri>
    </include>
    <link name="avia_link">
      <pose relative_to="base_link">0.12 0 0.12 0 0 0</pose>
      <inertial>
        <mass>0.498</mass>
        <inertia>
          <ixx>0.000329759</ixx>
          <iyy>0.000518999</iyy>
          <izz>0.000498083</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="mid360_collision">
        <geometry>
          <box>
            <size>0.091 0.061 0.065</size>
          </box>
        </geometry>
      </collision>
      <visual name="mid360_housing">
        <geometry>
          <box>
            <size>0.091 0.061 0.065</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.10 0.12 1</ambient>
          <diffuse>0.12 0.15 0.18 1</diffuse>
        </material>
      </visual>
      <sensor name="avia" type="custom">
        <plugin filename="RGLServerPluginInstance" name="rgl::RGLServerPluginInstance">
          <range>
            <min>0.1</min>
            <max>60</max>
          </range>
          <update_rate>10</update_rate>
          <update_on_paused_sim>false</update_on_paused_sim>
          <topic>/avia/points</topic>
          <frame>avia_link</frame>
          <pattern_preset>Livox Avia</pattern_preset>
        </plugin>
      </sensor>
    </link>
    <joint name="avia_joint" type="fixed">
      <parent>base_link</parent>
      <child>avia_link</child>
    </joint>
  </model>
</sdf>